{
  "expo": {
    "name": "PMED-AID",
    "slug": "pmedaid",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d64c1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pmedaid.app",
      "orientationLock": "ALL_BUT_UPSIDE_DOWN"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d64c1"
      },
      "package": "com.pmedaid.app",
      "orientationLock": "default"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "DEFAULT"
        }
      ]
    ]
  }
}
